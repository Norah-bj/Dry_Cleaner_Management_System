NODE_ENV=development
PORT=3000
# Comma-separated allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=edcms

# Generate a real secret for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access tokens are short-lived; the frontend renews them with a refresh token.
JWT_EXPIRES_IN=15m
# How long a signed-in session lasts without being used.
REFRESH_TOKEN_TTL_DAYS=30

# Rate limiting (per client IP). Leave on in every real environment.
RATE_LIMIT_ENABLED=true
# Behind a reverse proxy / load balancer, set to the number of proxies (e.g. 1)
# so rate limits see the real client IP. Leave empty when not behind a proxy.
TRUST_PROXY=

# Used only by `npm run seed` to create the first SUPER_ADMIN login -
# not read by the app itself.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
